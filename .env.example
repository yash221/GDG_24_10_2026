# Gemini (get a key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
VISION_MODEL=gemini-3.1-flash-lite

# Optional: Google Maps Geocoding for free-text area names
MAPS_API_KEY=

# sqlite (local) or firestore (Cloud Run)
STORE=sqlite
DB_PATH=civic.db
GOOGLE_CLOUD_PROJECT=

# Protects the demo endpoint that moves a ticket's status. Leave empty to disable it.
ADMIN_TOKEN=change-me-to-a-long-random-string

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
